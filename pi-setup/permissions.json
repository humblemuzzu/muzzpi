[
  {
    "tool": "Bash",
    "matches": {
      "cmd": [
        "*git add -A*",
        "*git add .*"
      ]
    },
    "action": "reject",
    "message": "stage files explicitly with 'git add <file>' \u2014 unstaged changes may not be yours"
  },
  {
    "tool": "Bash",
    "matches": {
      "cmd": [
        "*git push --force*",
        "*git push -f*",
        "*--force-with-lease*"
      ]
    },
    "action": "reject",
    "message": "never force push. if diverged: 'git fetch origin && git rebase origin/main && git push'"
  },
  {
    "tool": "Bash",
    "matches": {
      "cmd": [
        "regex:(?:^|[\\n;&|(\\x60{]|\\$\\(|-exec(?:dir)?\\s|-ok(?:dir)?\\s|--exec(?:-batch)?\\s)\\s*(?:(?:\\w+=\\S*|do|then|else|sudo|doas|env|builtin|exec|nohup|time|nice|timeout|watch|xargs|busybox|eval|chroot|stdbuf|ionice|caffeinate|ssh|command(?!\\s+-[vV]))\\b[^\\n;&|]{0,200}?\\s+)*[\"']?\\\\?(?:\\S*/)?(?:rm|rmdir|unlink|shred|srm)(?=$|[\\s;&|)\"'\\x60])",
        "regex:(?:\\$\\(|\\x60)\\s*(?:which|type\\s+-p|command\\s+-v)\\s+(?:rm|rmdir|unlink|shred)\\b",
        "regex:(?:\\s-\\w*c|\\beval|\\bforeach|\\bsystem|\\bexecSync|\\bexec|\\bspawnSync|\\bspawn|\\bcheck_call|\\bcheck_output|\\brun|\\bPopen|\\bcall)\\s*\\(?\\s*\\[?\\s*[\"'\\x60]\\s*(?:sudo\\s+)?(?:\\S*/)?(?:rm|rmdir|unlink|shred|srm)(?=$|[\\s\"'\\x60,\\]])",
        "regex:(?:\\.(?:rm|rmSync|rmdir|rmdirSync|unlink|unlinkSync|rmtree)|\\bos\\.(?:remove|removedirs)|\\bDeno\\.remove|\\bFile\\.delete|\\bFileUtils\\.rm\\w*|\\bunlink|\\brmtree)\\s*\\(|\\bunlink\\s+[\"'$]|\\bfrom\\s+os\\s+import\\b[^\\n]{0,200}\\b(?:remove|unlink|rmdir|removedirs)\\b",
        "regex:(?:^|[\\n;&|(\\x60{]|\\$\\(|-exec(?:dir)?\\s|-ok(?:dir)?\\s|--exec(?:-batch)?\\s)\\s*(?:sudo\\s+)?git\\s+(?:-C\\s+\\S+\\s+|-c\\s+\\S+\\s+|--\\S+\\s+){0,6}(?:rm|clean)\\b(?![^\\n;&|#$()]{0,500}?(?:--cached|--dry-run|\\s-[a-zA-Z]*n[a-zA-Z]*(?=\\s|$)))",
        "regex:(?:^|[\\n;&|(\\x60{]|\\$\\(|-exec(?:dir)?\\s|-ok(?:dir)?\\s|--exec(?:-batch)?\\s)\\s*(?:sudo\\s+)?find\\b[^\\n;&|]{0,500}?\\s-delete\\b",
        "regex:(?:^|[\\n;&|(\\x60{]|\\$\\(|-exec(?:dir)?\\s|-ok(?:dir)?\\s|--exec(?:-batch)?\\s)\\s*(?:sudo\\s+)?rsync\\b[^\\n;&|]{0,500}?\\s--(?:delete\\S*|remove-source-files)\\b"
      ]
    },
    "action": "reject",
    "message": "deleting is blocked \u2014 rm, rmdir, unlink, shred, find -delete, rsync --delete, git rm, git clean and delete calls in scripts. use 'trash <path>': it moves the file to the macOS Trash, where it can be recovered. (git rm --cached and dry runs are allowed.)"
  },
  {
    "tool": "Bash",
    "matches": {
      "cmd": [
        "regex:(?:^|(?<!\\\\)[;&|(]\\s*|\\bnohup\\s+|\\bxargs\\s+|-exec\\s+)amp\\s+[-\\w\"']"
      ]
    },
    "action": "reject",
    "message": "do not launch the amp CLI from bash \u2014 it is a separate program that runs outside this pi session. use the delegate / chad / oracle / finder / code_review / librarian tools, which run inside this pi session with your tools, permissions and visible output"
  },
  {
    "tool": "Bash",
    "matches": {
      "cmd": [
        "regex:(?:^|(?<!\\\\)[;&|(]\\s*|\\bnohup\\s+|\\bxargs\\s+|-exec\\s+)screencapture\\b"
      ]
    },
    "action": "reject",
    "message": "use the screenshot tool instead of capturing by hand \u2014 it takes the same shot and fits the image to the vision budget in ONE resample pass, where the hand-rolled way resizes to a guessed long edge that ignores the visual-token limit and makes the API resample a second time. displays, windows, regions and whole web pages are all supported; call screenshot({ list: true }) to see the targets"
  },
  {
    "tool": "*",
    "action": "allow"
  }
]
