{
  "lastChangelogVersion": "1.1.0",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "high",
  "theme": "gruvbox",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "skills": [
    "~/.config/agents/skills"
  ],
  "extensions": [
    "~/.pi/agent/extensions/editor",
    "~/.pi/agent/extensions/session-name.ts",
    "~/.pi/agent/extensions/system-prompt.ts",
    "~/.pi/agent/extensions/tools",
    "~/.pi/agent/extensions/command-palette",
    "~/.pi/agent/extensions/theme-studio",
    "~/.pi/agent/extensions/stats",
    "~/.pi/agent/extensions/notify.ts",
    "~/.pi/agent/extensions/mentions.ts",
    "-builtin:mcp"
  ],
  "compaction": {
    "enabled": true
  },
  "cacheWarming": "off",
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-haiku-5-5",
    "deepseek/deepseek-flash",
    "deepseek/deepseek-v4-pro",
    "openrouter/deepseek/deepseek-v4.1-flash",
    "openrouter/z-ai/glm-5.3-flash"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "doubleEscapeAction": "tree",
  "quietStartup": "header",
  "tuiMode": "fullscreen",
  "packages": [
    "npm:pi-token-burden",
    "npm:@benvargas/pi-claude-code-use@2.2.1",
    "npm:@marckrenn/pi-sub-bar",
    "npm:pi-tool-display",
    "npm:pi-codex-goal@0.6.0",
    { "source": "npm:pi-mcp-adapter@5.1.0", "skills": [] }
  ],
  "terminal": {
    "clearOnShrink": false,
    "showImages": false
  },
  "warnings": {
    "anthropicExtraUsage": false
  }
}
