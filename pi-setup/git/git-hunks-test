#!/usr/bin/env bash
#
# git-hunks-test — adversarial test suite for git-hunks.
#
# Run it after ANY change to git-hunks:   bash git-hunks-test
# Exit 0 = safe. Builds throwaway repos under /tmp, touches nothing else.
#
# Every case here is a bug that was actually FOUND, not an imagined one. The
# three that mattered:
#   - two agents with different path scopes shared one state file, and agent A
#     silently staged agent B's file and exited 0
#   - `list -R` / `--cached` / `-U0` were taken as git-diff FLAGS, so the tool
#     listed one diff and staged a different one
#   - during an unresolved merge, git emits a combined diff and the parser
#     printed "@@@ -1,3 -1,3 +1,7 @@@" in the FILENAME column

set -uo pipefail

HUNKS="${HUNKS:-$(cd "$(dirname "$0")" && pwd)/git-hunks}"
[ -x "$HUNKS" ] || { echo "not executable: $HUNKS" >&2; exit 1; }

pass=0; fail=0
t() {
	if [ "$2" = "$3" ]; then
		pass=$((pass + 1)); printf 'PASS  %s\n' "$1"
	else
		fail=$((fail + 1)); printf 'FAIL  %s\n        got  [%s]\n        want [%s]\n' "$1" "$2" "$3"
	fi
}
tok() { grep -m1 'hunks show' | sed 's/.*hunks show \([0-9a-f]*\).*/\1/'; }
reset() { git reset -q --hard HEAD >/dev/null 2>&1; }

# `sed -i` is incompatible between BSD (macOS) and GNU: BSD needs an explicit
# backup-suffix argument and reads `-e` as that suffix, silently corrupting the
# invocation. Avoid -i entirely so this suite runs the same on both.
edit() {
	local f="$1"; shift
	local tmp; tmp="$(mktemp)"
	sed "$@" "$f" > "$tmp" && cat "$tmp" > "$f"
	rm -f "$tmp"
}

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

newrepo() {
	local d="$WORK/$1"
	mkdir -p "$d" && cd "$d" || exit 1
	git init -q .
	git config user.email t@test; git config user.name test
}

# ---------------------------------------------------------------- core
newrepo core
printf 'a\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk\nl\nm\n' > f.txt
printf 'one\ntwo\nthree\n' > other.txt
printf 'aa\nbb\ncc\ndd\nee\n' > "alpha notes.txt"
printf 'aa\nbb\ncc\ndd\nee\n' > "beta notes.txt"
git add . && git commit -qm init

reset; edit f.txt -e 's/^b$/b MINE/' -e 's/^l$/l THEIRS/'
T=$("$HUNKS" list | tok); "$HUNKS" add "$T" 1 >/dev/null 2>&1
t "stages only my hunk"            "$(git diff --cached | grep -c 'b MINE')" "1"
t "leaves their hunk unstaged"     "$(git diff | grep -c 'l THEIRS')" "1"
t "working tree untouched"         "$(grep -c 'THEIRS' f.txt)" "1"

# ------------------------------------------------- staleness / identity
reset; edit f.txt -e 's/^b$/b MINE/'; T=$("$HUNKS" list | tok); echo x >> f.txt
"$HUNKS" add "$T" 1 >/dev/null 2>&1; t "edit between list and add -> refuse" "$?" "1"
t "  ...and stages nothing"        "$(git diff --cached --name-only)" ""

reset; edit f.txt -e 's/^b$/b MINE/'; T=$("$HUNKS" list | tok)
"$HUNKS" add "$T" 1 >/dev/null 2>&1; t "clean add exits 0"                "$?" "0"

reset; edit f.txt -e 's/^b$/b M/' -e 's/^l$/l T/'; T=$("$HUNKS" list | tok)
"$HUNKS" add "$T" 1 >/dev/null 2>&1
"$HUNKS" add "$T" 2 >/dev/null 2>&1; t "spent token refused"              "$?" "1"
T2=$("$HUNKS" list | tok); "$HUNKS" add "$T2" 1 >/dev/null 2>&1
t "re-list recovers"               "$?" "0"
t "both hunks land eventually"     "$(git diff --cached | grep -cE ' M$| T$')" "2"

# ---------------------------------------------------- THE CONCURRENCY BUG
# Two bugs lived here, both measured, both fixed:
#   1. SAFETY: with one shared state file, agent A ran `add 1` and silently
#      staged agent B's file, exit 0.
#   2. USABILITY: after adding a token but keeping shared state, A and B were
#      refused and only the agent that listed LAST could stage — safe, but it
#      made parallel agents thrash in a re-list loop.
# Per-token state dirs fix both: everyone stages their own work, first try.
reset; edit f.txt -e 's/^b$/b AGENT-A/'; edit other.txt -e 's/^two$/two AGENT-B/'
edit "alpha notes.txt" -e 's/^bb$/bb AGENT-C/'
TA=$("$HUNKS" list f.txt | tok)
TB=$("$HUNKS" list other.txt | tok)              # concurrent agents list too
TC=$("$HUNKS" list "alpha notes.txt" | tok)
"$HUNKS" add "$TA" 1 >/dev/null 2>&1; t "3 parallel agents: A stages"      "$?" "0"
"$HUNKS" add "$TB" 1 >/dev/null 2>&1; t "3 parallel agents: B stages"      "$?" "0"
"$HUNKS" add "$TC" 1 >/dev/null 2>&1; t "3 parallel agents: C stages"      "$?" "0"
t "  ...each got its OWN hunk"     "$(git diff --cached | grep -cE 'AGENT-A|AGENT-B|AGENT-C')" "3"
t "  ...A staged f.txt, not B's"   "$(git diff --cached --name-only | grep -c '^f.txt$')" "1"

# and a token still cannot be reused after it is spent
reset; edit f.txt -e 's/^b$/b MINE/'
T=$("$HUNKS" list f.txt | tok); "$HUNKS" add "$T" 1 >/dev/null 2>&1
"$HUNKS" add "$T" 1 >/dev/null 2>&1; t "spent token cannot be replayed"     "$?" "1"

# ------------------------------------------------------ flag injection
reset; edit f.txt -e 's/^b$/b MINE/'
for fl in --cached -R -U0 --ignore-all-space --no-index; do
	"$HUNKS" list "$fl" >/dev/null 2>&1; t "git-diff flag '$fl' refused" "$?" "1"
done

# ------------------------------------------------------------ bad input
reset; edit f.txt -e 's/^b$/b M/' -e 's/^l$/l T/'; T=$("$HUNKS" list | tok)
"$HUNKS" add "$T" 1 99  >/dev/null 2>&1; t "out-of-range id refused"    "$?" "1"
t "  ...and stages nothing"        "$(git diff --cached --name-only)" ""
"$HUNKS" add "$T" 1 foo >/dev/null 2>&1; t "non-numeric id refused"     "$?" "1"
"$HUNKS" add "$T" 0     >/dev/null 2>&1; t "id 0 refused"               "$?" "1"
"$HUNKS" add 1          >/dev/null 2>&1; t "missing token refused"      "$?" "1"
"$HUNKS" add deadbe 1   >/dev/null 2>&1; t "unknown token refused"      "$?" "1"
"$HUNKS" show deadbe 1  >/dev/null 2>&1; t "show rejects bad token"     "$?" "1"
t "show never stages"              "$(git diff --cached --name-only)" ""

# -------------------------------------------------------- file shapes
reset; edit "alpha notes.txt" -e 's/^bb$/bb A/'; edit "beta notes.txt" -e 's/^dd$/dd B/'
t "spaced filename displayed"      "$("$HUNKS" list | awk 'NR==3{print $2,$3}')" "alpha notes.txt"
T=$("$HUNKS" list | tok); "$HUNKS" add "$T" 2 >/dev/null 2>&1
t "spaced filename staged"         "$(git diff --cached --name-only)" "beta notes.txt"

reset; edit f.txt -e 's/^b$/b STAGED/'; git add f.txt; edit f.txt -e 's/^l$/l LATER/'
T=$("$HUNKS" list | tok); "$HUNKS" add "$T" 1 >/dev/null 2>&1
t "file with staged+unstaged both" "$(git diff --cached | grep -cE 'b STAGED|l LATER')" "2"

reset; chmod +x f.txt
t "mode-only change -> no hunks"   "$("$HUNKS" list)" "no unstaged changes to tracked files"
chmod -x f.txt

reset; printf '\x00\x01\x02BIN' > b.bin; git add b.bin; git commit -qm bin
printf '\x00\x01\x02CHANGED' > b.bin
t "binary file -> no false hunk"   "$("$HUNKS" list)" "no unstaged changes to tracked files"
reset

reset; python3 -c "import os; os.remove('other.txt')" 2>/dev/null || rm -f other.txt
t "deleted file named correctly"   "$("$HUNKS" list | awk 'NR==3{print $2}')" "other.txt"
reset

t "clean repo message"             "$("$HUNKS" list)" "no unstaged changes to tracked files"
"$HUNKS" add abc123 1 >/dev/null 2>&1; t "add on clean repo refused"    "$?" "1"

# ------------------------------------------------------ merge conflict
newrepo conflict
printf 'l1\nl2\nl3\n' > c.txt; git add . && git commit -qm base
git checkout -q -b other && edit c.txt -e 's/^l2$/l2 OTHER/' && git commit -qam other
git checkout -q - && edit c.txt -e 's/^l2$/l2 MAIN/' && git commit -qam main
git merge other >/dev/null 2>&1
"$HUNKS" list >/dev/null 2>&1;        t "conflicted repo: list refuses"   "$?" "1"
"$HUNKS" add abc123 1 >/dev/null 2>&1; t "conflicted repo: add refuses"   "$?" "1"
t "conflicted repo: index intact"  "$(git status --short | head -1 | cut -c1-2)" "UU"

# ------------------------------------------- the load-bearing guarantee
newrepo untouched
printf 'a\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk\nl\nm\n' > f.txt
printf 'one\ntwo\nthree\n' > other.txt
git add . && git commit -qm init
edit f.txt -e 's/^b$/b MINE/' -e 's/^l$/l THEIRS/'; edit other.txt -e 's/^two$/two OTHER/'
snapshot() { find . -path ./.git -prune -o -type f -print0 | xargs -0 shasum | sort | shasum; }
BEFORE="$(snapshot)"
T=$("$HUNKS" list | tok)
"$HUNKS" show "$T" 1 2 >/dev/null 2>&1
"$HUNKS" add "$T" 1 >/dev/null 2>&1
"$HUNKS" verify >/dev/null 2>&1
"$HUNKS" add "$T" 2 >/dev/null 2>&1        # refused
"$HUNKS" list --cached >/dev/null 2>&1     # refused
"$HUNKS" add zzz 9 >/dev/null 2>&1         # refused
t "WORKING TREE NEVER MODIFIED"    "$(snapshot)" "$BEFORE"

echo
if [ "$fail" -eq 0 ]; then
	echo "$pass passed, 0 failed — safe"
else
	echo "$pass passed, $fail FAILED"
fi
exit $((fail > 0))
